generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GebruikerStatus {
  actief
  geblokkeerd
}

enum UitslagType {
  volledig
  klein
}

enum UitslagTarief {
  standaard
  geetiketteerd
}

// Aanpasbare rollen met per-scherm rechten (i.p.v. een vaste beheerder/
// medewerker/lezer-enum), zodat een beheerder zelf rollen kan samenstellen
// — bijvoorbeeld iemand die alleen Voorraad mag zien.
model Rol {
  id              String   @id @default(uuid())
  naam            String   @unique
  canInslag       Boolean  @default(false)
  canUitslag      Boolean  @default(false)
  canVoorraad     Boolean  @default(false)
  canFacturatie   Boolean  @default(false)
  canReserveren   Boolean  @default(false)
  canBeheer       Boolean  @default(false) // validatielijsten, gebruikers én rollen
  canActiviteiten Boolean  @default(false) // activiteitenlog (§ audit) — eigen vinkje, los van "Beheer"
  // Los van canReserveren instelbaar: bepaalt of iemand met deze rol een
  // pushmelding krijgt bij een nieuwe afroeporder. Zo kan een beheerder
  // bijvoorbeeld kiezen dat alleen "Magazijn" meldingen krijgt en niet elke
  // rol die toevallig ook afroep-rechten heeft.
  ontvangtAfroepMeldingen Boolean @default(true)
  createdAt       DateTime @default(now())

  gebruikers Gebruiker[]
}

model Gebruiker {
  id        String          @id @default(uuid())
  naam      String
  email     String          @unique
  rol       Rol?            @relation(fields: [rolId], references: [id])
  // Optioneel gehouden i.p.v. verplicht: zo blijft het toevoegen van dit
  // veld aan een bestaande, gevulde tabel een niet-destructieve wijziging
  // (geen "reset de hele database"-waarschuwing). db:seed kent automatisch
  // de standaardrol Beheerder toe aan elke bestaande gebruiker die nog geen
  // rol heeft — zie prisma/seed.ts.
  rolId     String?
  status    GebruikerStatus @default(actief)
  createdAt DateTime        @default(now())

  loginCodes     LoginCode[]
  devicePincodes DevicePincode[]
  inslagLogs     InslagLog[] @relation("InslagDoor")
  uitslagLogs    UitslagLog[] @relation("UitslagDoor")
  afroepen  Afroep[]
  afroepenAfgehandeld Afroep[] @relation("AfroepAfgehandeldDoor")
  pushSubscriptions PushSubscription[]
}

// Eenmalige inlogcode, zie ontwerpdocument §3.5 / §4.2
model LoginCode {
  id          String   @id @default(uuid())
  gebruiker   Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  gebruikerId String
  codeHash    String
  verlooptOp  DateTime
  gebruikt    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Pincode per toestel, zie §3.5 / §4.3 (harde 2-wekelijkse hergeldigheidsgrens)
model DevicePincode {
  id             String   @id @default(uuid())
  gebruiker      Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  gebruikerId    String
  deviceId       String
  pincodeHash    String
  sessieVerlooptOp DateTime
  createdAt      DateTime @default(now())

  @@unique([gebruikerId, deviceId])
}

// Actuele voorraad, zie §3.1
model Box {
  id               String   @id @default(uuid())
  boxId            Int      @unique @default(autoincrement())
  productafkomst   String
  proces           String
  model            String
  partijcode       String
  productiedatum   DateTime
  aantalKazen      Int
  nettoGram        Int
  opmerking        String?
  createdAt        DateTime @default(now())
  laatsteMutatie   DateTime @updatedAt
}

// Onveranderlijke transactiehistorie, zie §3.2 (transactionId = idempotency-sleutel)
model InslagLog {
  id             String   @id @default(uuid())
  transactionId  String   @unique
  boxId          Int
  productafkomst String
  proces         String
  model          String
  partijcode     String
  productiedatum DateTime
  aantalKazen    Int
  nettoGram      Int
  opmerking      String?
  inslagtijd     DateTime @default(now())
  gebruiker      Gebruiker? @relation("InslagDoor", fields: [gebruikerId], references: [id], onDelete: SetNull)
  gebruikerId    String?
}

model UitslagLog {
  id             String        @id @default(uuid())
  transactionId  String        @unique
  boxId          Int
  productafkomst String
  proces         String
  model          String
  partijcode     String
  productiedatum DateTime
  uitslagType    UitslagType
  tarief         UitslagTarief
  aantalKazenUit Int
  nettoGramUit   Int
  opmerking      String?
  uitslagtijd    DateTime      @default(now())
  gebruiker      Gebruiker?    @relation("UitslagDoor", fields: [gebruikerId], references: [id], onDelete: SetNull)
  gebruikerId    String?
  afroep         Afroep?       @relation(fields: [afroepId], references: [id], onDelete: SetNull)
  afroepId       String?       @map("reserveringId")
}

// Dagelijkse aggregatie, zie §3.3 (basis voor kg-dagen-opslagberekening)
model DagVoorraadSnapshot {
  id             String   @id @default(uuid())
  datum          DateTime
  partijcode     String
  productafkomst String
  model          String
  nettoGram      Int
  createdAt      DateTime @default(now())

  @@unique([datum, partijcode, productafkomst, model])
}

// Validatielijsten voor Productafkomst, Proces en Model (§3.1 "fk naar
// validaties" / §6 "Leveranciers"-scherm) — één generieke tabel i.p.v. drie
// losse, met een "soort" om ze uit elkaar te houden.
enum ValidatieSoort {
  productafkomst
  proces
  model
  klant
}

model ValidatieItem {
  id        String         @id @default(uuid())
  soort     ValidatieSoort
  naam      String
  actief    Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@unique([soort, naam])
}

enum AfroepStatus {
  open
  uitgevoerd
  geannuleerd

  @@map("ReserveringStatus")
}

// Afroep van (een deel van) een box door een verkoper op de vloer, bedoeld
// voor uitslag naar de groothandel. Puur informatief bovenop de bestaande
// voorraad — beïnvloedt Box/InslagLog/UitslagLog niet vanzelf.
// @@map houdt de onderliggende tabelnaam "Reservering" aan (zo bleef deze
// hernoeming een risicoloze wijziging, zonder migratie/reset van bestaande
// afroeporders).
model Afroep {
  id              String       @id @default(uuid())
  boxId           Int
  volledigeBox    Boolean      @default(true)
  aantalKazen     Int?         // alleen gevuld als volledigeBox = false
  klant           String?
  opmerking       String?
  status          AfroepStatus @default(open)
  gebruiker       Gebruiker    @relation(fields: [gebruikerId], references: [id])
  gebruikerId     String
  createdAt       DateTime     @default(now())

  // Wie de afroep op "uitgevoerd" (of "geannuleerd") heeft gezet, en
  // wanneer — apart van gebruiker/createdAt hierboven, dat is wie 'm
  // aanmaakte. Optioneel: leeg zolang de status nog "open" is.
  afgehandeldDoor   Gebruiker? @relation("AfroepAfgehandeldDoor", fields: [afgehandeldDoorId], references: [id], onDelete: SetNull)
  afgehandeldDoorId String?
  afgehandeldOp     DateTime?

  uitslagLogs UitslagLog[]

  @@map("Reservering")
}

// Activiteitenlog voor het "wie deed wat, wanneer"-overzicht. Bewust met
// een losse naam/e-mail-snapshot i.p.v. een verplichte koppeling naar
// Gebruiker: als een gebruiker later verwijderd wordt, blijft de
// geschiedenis toch leesbaar (zie ook §9 audit-opmerking in het
// ontwerpdocument).
model AuditLog {
  id             String   @id @default(uuid())
  gebruikerNaam  String
  gebruikerEmail String
  actie          String
  omschrijving   String
  createdAt      DateTime @default(now())
}

// Eén rij per toestel dat meldingen heeft ingeschakeld (§ pushmeldingen bij
// afroeporders). Een gebruiker kan op meerdere toestellen ingeschreven staan.
model PushSubscription {
  id          String    @id @default(uuid())
  gebruiker   Gebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)
  gebruikerId String
  endpoint    String    @unique
  p256dh      String
  auth        String
  createdAt   DateTime  @default(now())
}
