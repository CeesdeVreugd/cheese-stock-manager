# LET OP: bij de Portainer-opzet (zie SELFHOSTING.md) wordt dit bestand
# niet rechtstreeks gebruikt — Portainer's "Stacks from Git" leest geen
# lokaal .env-bestand. Vul deze zelfde variabelen in plaats daarvan in bij
# het aanmaken van de stack, onder Portainer's eigen "Environment
# variables"-sectie. Dit bestand dient dan puur als overzicht van welke
# variabelen nodig zijn en in welk formaat.
#
# Dit bestand is specifiek voor de Docker-opzet op de VM — een apart
# bestand van de gewone .env (die blijft voor de Vercel-omgeving).

# Wachtwoord voor de Postgres-container. Kies zelf een lang, willekeurig
# wachtwoord (bv. met: openssl rand -hex 24)
POSTGRES_PASSWORD=""

# Verbinding van de app náár diezelfde Postgres-container — let op: de
# gebruikersnaam/databasenaam/wachtwoord hieronder moeten exact overeenkomen
# met wat je hierboven bij POSTGRES_PASSWORD hebt gekozen. "postgres" als
# hostnaam werkt automatisch: dat is de servicenaam uit docker-compose.yml,
# Docker lost dat zelf op naar het juiste interne IP-adres.
DATABASE_URL="postgresql://cheesestock:VUL_HETZELFDE_WACHTWOORD_HIER_IN@postgres:5432/cheesestock"

# Dezelfde variabelen als in de Vercel-omgeving — kopieer de waarden die je
# daar al hebt (Resend, Microsoft Graph, VAPID, SESSION_SECRET, etc.)
RESEND_API_KEY=""
RESEND_FROM="Cheese Stock Manager <inloggen@jouwdomein.nl>"

MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_SENDER_EMAIL=""

SESSION_SECRET=""

NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
